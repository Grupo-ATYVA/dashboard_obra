# Modelo do arquivo /opt/dashboard/.env (no servidor, permissão 600).
# Formato: NOME=valor, SEM aspas e SEM espaços em volta do "=" (o Docker lê literalmente).
# Dica: o script deploy\gerar_env.ps1 monta este arquivo a partir do iniciar_dashboard.bat,
# sem mostrar as senhas na tela.

# --- endereço público ---
DASH_DOMAIN=painel.seudominio.com.br
ACME_EMAIL=ti@seudominio.com.br
DASHBOARD_HTTPS=1
# o container já define DASHBOARD_BEHIND_PROXY=1 (o painel fica atrás do Caddy). Sem isso o IP real
# do visitante some e o limite de tentativas de login passa a contar o proxy inteiro.
# sites autorizados a embutir o painel em iframe (ex.: SharePoint), separados por espaço.
# Vazio = ninguém pode embutir (mais seguro). Aqui já está o SharePoint da Temazec; apague o valor
# se o painel for aberto só pelo endereço próprio. Atenção: dentro de um iframe de outro domínio o
# navegador não envia o cookie de login (SameSite=Lax); o uso mais simples é um link/botão no
# SharePoint que abre o painel em outra aba.
DASHBOARD_FRAME_ANCESTORS=https://temazeccombr.sharepoint.com
# horas de inatividade até a sessão expirar (padrão 12)
DASHBOARD_SESSION_HOURS=12

# --- segurança ---
# assina a sessão dos logins e protege a senha de e-mail salva na Carta Convite
DASHBOARD_SECRET_KEY=
# só vale no PRIMEIRO acesso (criar o administrador). Depois de criar, pode apagar.
DASHBOARD_SETUP_TOKEN=

# --- integrações (mesmos valores do iniciar_dashboard.bat) ---
AUTODOC_EMAIL=
AUTODOC_SENHA=
CERT_PFX_SENHA=
MELIUS_USER=
MELIUS_PASSWORD=
MELIUS_SITE_SENHA=
MELIUS_TOKEN=
DIRECTD_API_TOKEN=

# --- desempenho (opcional) ---
GUNICORN_THREADS=16
# mantenha 1 worker (estado em memória); veja gunicorn.conf.py
GUNICORN_TIMEOUT=900
